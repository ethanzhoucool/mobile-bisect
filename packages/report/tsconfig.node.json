{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist-node",
    "rootDir": "src-node",
    "types": ["node"]
  },
  "include": ["src-node"],
  "exclude": ["src-node/**/*.test.ts"]
}
