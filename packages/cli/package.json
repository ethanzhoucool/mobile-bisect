{
  "name": "mobile-bisect",
  "version": "0.1.0",
  "description": "git bisect for visual mobile regressions: binary-search a Swift, Kotlin, React Native or Expo app's history on cloud devices until one commit is to blame",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mobile-bisect": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md"
  ],
  "keywords": [
    "expo",
    "react-native",
    "ios",
    "android",
    "xcode",
    "gradle",
    "swift",
    "kotlin",
    "bisect",
    "regression",
    "e2e",
    "testing",
    "revyl"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "tsc -b && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mobile-bisect/core": "^0.1.0",
    "@mobile-bisect/git": "^0.1.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.6.0"
  },
  "optionalDependencies": {
    "@mobile-bisect/report": "^0.1.0",
    "@mobile-bisect/revyl-runner": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
