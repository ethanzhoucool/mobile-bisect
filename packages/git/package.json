{
  "name": "@mobile-bisect/git",
  "version": "0.1.0",
  "description": "Read-only git access and detached worktrees for mobile-bisect. Never touches your working tree.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "tsc -b && vitest run"
  },
  "dependencies": {
    "@mobile-bisect/core": "*"
  },
  "engines": {
    "node": ">=18"
  }
}
